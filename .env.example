# ---------------------------------------------------------------------------
# TradeStox — environment variables
#
# Copy to `.env.local` for development, or paste the same keys into your host's
# environment settings for production. Never commit the filled-in file.
#
#   cp .env.example .env.local
#
# On first boot the app seeds a superadmin from ADMIN_EMAIL / ADMIN_PASSWORD.
# If ADMIN_PASSWORD is left blank a RANDOM one is generated and printed once to
# the server log — that is the safer option, because these values end up in
# shell history and host dashboards.
# ---------------------------------------------------------------------------

# --- Market data (Upstox) ---------------------------------------------------
# Required. Without a token the app still boots, but every quote, candle and
# option chain fails and the top-of-page feed badge reads as disconnected.
#
# A single Upstox access token can power both REST quotes and the websocket
# feed. Analytics tokens work for the public endpoints; a full access token is
# needed if you want account-scoped data. Tokens expire — Upstox access tokens
# are short-lived, so plan to rotate this.
UPSTOX_ANALYTICS_TOKEN=
UPSTOX_ACCESS_TOKEN=

# Separate token for the websocket feed only. Optional: the feed falls back to
# UPSTOX_ACCESS_TOKEN and then UPSTOX_ANALYTICS_TOKEN.
UPSTOX_FEED_TOKEN=

# Used by the OAuth login flow. Not read by the app itself today — only needed
# if you later add a "connect your Upstox account" button.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=

# --- Admin console ----------------------------------------------------------
# Seeds the first superadmin. Change the password from inside the console after
# the first login (Keys & Access).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- Session signing --------------------------------------------------------
# Signs the auth cookies (HMAC in proxy.ts / authStore.ts). Generate a fresh
# one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If this changes, every signed-in user is logged out.
AUTH_SECRET=

# --- Public site URL --------------------------------------------------------
# Used for canonical URLs, robots.txt and the sitemap.
# NEXT_PUBLIC_* is inlined at BUILD time, so set this before building, not just
# before running.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

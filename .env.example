# ---------------------------------------------------------------------------
# TradeStox — environment variables
#
# Copy to `.env.local` for development, or paste the same keys into your host's
# environment settings for production. Never commit the filled-in file.
#
#   cp .env.example .env.local
#
# On first boot the app seeds a superadmin from ADMIN_EMAIL / ADMIN_PASSWORD.
# If ADMIN_PASSWORD is left blank a RANDOM one is generated and printed once to
# the server log — that is the safer option, because these values end up in
# shell history and host dashboards.
# ---------------------------------------------------------------------------

# --- Market data (Upstox) ---------------------------------------------------
# Required. Without a token the app still boots, but every quote, candle and
# option chain fails and the top-of-page feed badge reads as disconnected.
#
# A single Upstox access token can power both REST quotes and the websocket
# feed. Analytics tokens work for the public endpoints; a full access token is
# needed if you want account-scoped data. Tokens expire — Upstox access tokens
# are short-lived, so plan to rotate this.
UPSTOX_ANALYTICS_TOKEN=
UPSTOX_ACCESS_TOKEN=

# Separate token for the websocket feed only. Optional: the feed falls back to
# UPSTOX_ACCESS_TOKEN and then UPSTOX_ANALYTICS_TOKEN.
UPSTOX_FEED_TOKEN=

# Used by the OAuth login flow. Not read by the app itself today — only needed
# if you later add a "connect your Upstox account" button.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=

# --- Admin console ----------------------------------------------------------
# Seeds the first superadmin. Change the password from inside the console after
# the first login (Keys & Access).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- Session signing --------------------------------------------------------
# Signs the auth cookies (HMAC in proxy.ts / authStore.ts). Generate a fresh
# one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If this changes, every signed-in user is logged out.
AUTH_SECRET=

# --- Public site URL --------------------------------------------------------
# Used for canonical URLs, robots.txt and the sitemap.
# NEXT_PUBLIC_* is inlined at BUILD time, so set this before building, not just
# before running.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Used to build absolute URLs in server responses — short links, QR codes and
# payment callbacks. Behind a proxy, `req.nextUrl.origin` resolves to the app's
# INTERNAL address (https://localhost:3000), which is what every partner link
# used to point at. Set this to the real public origin.
PUBLIC_BASE_URL=https://your-domain.example

# --- Ad conversion tracking -------------------------------------------------
# ALL OF THIS IS OPTIONAL. With none of it set the app tracks nothing and the
# landing pages work normally — nothing is sent anywhere, and no phantom network
# calls are made. Every value below turns on one specific capability.
#
# The two halves are independent:
#   * the BROWSER pixels (NEXT_PUBLIC_*) measure in the visitor's browser
#   * the SERVER-side APIs (tokens/secrets) recover the 20-40% that browsers
#     lose to tracking prevention, and are what makes the counts trustworthy
#
# Set the browser half first; it is the one that shows immediate results.

# Your own Meta pixel (TradeStox's, not a partner's).
# NEXT_PUBLIC_* is inlined at BUILD time — set it before building, not just
# before running.
NEXT_PUBLIC_META_PIXEL_ID=
# Meta Conversions API token, from Events Manager. SERVER-ONLY: this is a
# credential that can write into your ad account, so it must never gain a
# NEXT_PUBLIC_ prefix. Without it, events are still recorded but not forwarded.
META_CAPI_TOKEN=
# Overrides, for testing against a mock. Leave blank in production.
META_API_VERSION=
META_GRAPH_BASE=

# Your own GA4 property. Same build-time rule as above.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# GA4 Measurement Protocol API secret. SERVER-ONLY.
GA4_API_SECRET=
# Override, for testing. Leave blank in production.
GA4_MP_BASE=

# --- Partner tracking credentials -------------------------------------------
# Encrypts the Meta tokens that PARTNERS hand over so we can send conversions on
# their behalf. AES-256-GCM.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ⚠️ BACK THIS UP. It is not derivable and there is no recovery path: lose it
# and every partner token already stored becomes permanently undecryptable, and
# those partners have to paste their tokens in again. Changing it has the same
# effect.
#
# If this is left blank, partners can still add a pixel ID (the browser pixel
# works) but saving a token is refused with a clear message rather than being
# stored in the clear. That refusal is deliberate — see app/lib/pixelCrypto.ts.
TRACKING_ENC_KEY=

# Shared secret for POST /api/track/dispatch, which sends what is owed to Meta
# and Google. With no secret set the endpoint refuses every request: an endpoint
# that falls open when a variable is missing is worse than one that is down.
#
# Something has to call it — a cron or systemd timer every few minutes. Landing
# page visits also trigger a small opportunistic drain, so it works without a
# timer, but that alone is not reliable enough to depend on.
TRACKING_DISPATCH_SECRET=

# --- Cookie consent ---------------------------------------------------------
# The banner is shown only in jurisdictions that require one (EEA, UK,
# Switzerland, Brazil, South Korea). Everywhere else — including India, the main
# market — the visitor is not interrupted.
#
# What to do when the visitor's country CANNOT be determined (a missing
# `cf-ipcountry` header, `XX`, or Tor):
#   exempt   (default) no banner, tags load
#   required            show the banner to be safe
#
# ⚠️ `exempt` is the riskier default. If the Cloudflare header ever goes missing
# in production, EEA visitors are treated as exempt and see no banner. Set this
# to `required` if the geo header is ever in doubt. There is a test that fails
# loudly if the default changes, so this is a deliberate act either way.
TRACKING_CONSENT_DEFAULT=
# Force a country for testing a banner you would otherwise never see locally,
# e.g. TRACKING_GEO=DE. Blank in production.
TRACKING_GEO=

